# ─── RoadSense Fleet — Environment Configuration ───
# Copy this file to .env and adjust values as needed.

# ─── Database ───
# Local development (SQLite):
DATABASE_URL=sqlite:///./roadsense.db
# Render / Production (PostgreSQL — set via Render dashboard):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── AI Model Paths (relative to backend/ directory) ───
# Required (vehicle detection):
VEHICLE_MODEL_PATH=models/yolov8n.pt
# Optional (detectors gracefully skip if file is missing):
POTHOLE_MODEL_PATH=models/pothole_yolov8.pt
ROAD_DAMAGE_MODEL_PATH=models/road_damage.pt

# ─── Roboflow Multi-Workflow Serverless API ───
# Supply your private API key here (never commit this key to version control)
ROBOFLOW_ENABLED=true
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=vasikaran-a
ROBOFLOW_ROAD_DAMAGE_WORKFLOW=general-segmentation-api
ROBOFLOW_TRAFFIC_SIGN_WORKFLOW=general-segmentation-api-2
ROBOFLOW_ZEBRA_CROSSING_WORKFLOW=general-segmentation-api-3
ROBOFLOW_INTERVAL_SECONDS=2.0

# ─── Detection Settings ───
DETECTION_CONFIDENCE=0.40
EVENT_COOLDOWN_SECONDS=5
DUPLICATE_IOU_THRESHOLD=0.3

# ─── Frame Processing ───
FRAME_PROCESS_INTERVAL=5
JPEG_QUALITY=70

# ─── Server ───
HOST=0.0.0.0
PORT=8000

# ─── CORS ───
# Use "*" for development, or comma-separated origins for production:
# CORS_ORIGINS=https://roadsense-fleet.onrender.com,https://yourdomain.com
CORS_ORIGINS=*

# ─── Snapshot Storage ───
# Path relative to backend/ directory. Auto-created if missing.
# WARNING: Render's filesystem is ephemeral — snapshots are lost on redeploy.
SNAPSHOT_DIR=uploads/snapshots

# ─── Map Defaults (Chennai) ───
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707
MAP_ZOOM=12
