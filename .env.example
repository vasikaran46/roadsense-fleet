# RoadSense Fleet - Environment Configuration
# Copy this file to .env and adjust values

# Database
DATABASE_URL=sqlite:///./roadsense.db

# AI Model Paths
POTHOLE_MODEL_PATH=backend/models/pothole_yolov8.pt
ROAD_DAMAGE_MODEL_PATH=backend/models/road_damage.pt
VEHICLE_MODEL_PATH=backend/models/yolov8n.pt

# Detection Settings
DETECTION_CONFIDENCE=0.40
EVENT_COOLDOWN_SECONDS=5
DUPLICATE_IOU_THRESHOLD=0.3

# Frame Processing
FRAME_PROCESS_INTERVAL=5
JPEG_QUALITY=70

# Server
HOST=0.0.0.0
PORT=8000

# Map Defaults (Chennai)
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707
MAP_ZOOM=12
